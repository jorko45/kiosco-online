# === CREDENCIALES — NUNCA subir a GitHub ===
# SUBIR.bat hace "git add -A", asi que todo lo que no este aca termina publicado.
USUARIO Y CLAVE DE FORTI.txt
*CLAVE*.txt
*PASSWORD*.txt
*credenciales*
.env
.env.*

# Material de campana publicitaria — NO debe publicarse en el sitio
# (Vercel sirve la raiz del repo, asi que todo lo que se commitea queda online)
# La barra inicial ancla el patron a la raiz: sin ella tambien se excluiria
# cualquier carpeta "campana" anidada.
/campana/

# Basura de LibreOffice/Excel (archivos abiertos)
.~lock.*#
~$*

# Python
__pycache__/
*.pyc

# Backups y volcados de trabajo
index.html.backup
apps-script-actual.txt
*.bak

# Planillas y datos de trabajo (no van a la web)
*.xlsx
dino_products.json
_precios_master.json
cambios_precios.csv

# Imagenes sueltas de la raiz (las buenas viven en img/)
/portada.png
/Gemini_Generated_Image_*.png
/Kiosco Interactivo.png
/image_*.png
log_precios.txt

# Secreto que autoriza a tocar la planilla de precios
secreto_planilla.txt

# jsdom y demas dependencias de prueba: no van al repo ni a Vercel.
# package.json tambien queda afuera a proposito: el sitio nunca tuvo uno,
# y agregarlo hace que Vercel corra npm install en cada deploy. Para
# reproducir las pruebas alcanza con: npm install jsdom
node_modules/
package.json
package-lock.json
